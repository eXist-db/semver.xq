{
  "tagFormat": "${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits"
    }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits"
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version --allow-same-version",
      "publishCmd": "npm run build"
    }],
    "@existdb/repo-xml-changelog-generator",
    ["@semantic-release/git", {
      "assets": ["package.json", "repo.xml.tmpl"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [{
        "path": "dist/semver-xq-*.xar",
        "name": "semver-xq-${nextRelease.version}.xar",
        "label": "Expath package (semver-xq-${nextRelease.version}.xar)"
      }]
    }]
  ]
}
